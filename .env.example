# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Database URL
# For App (Pooled connection with -pooler and sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# For Migrations (Direct connection without -pooler):
# DIRECT_DATABASE_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# If DATABASE_URL is not set, defaults to sqlite3 for offline/local testing
DATABASE_URL=

# Media Storage (local / s3 / cloudinary)
MEDIA_STORAGE_BACKEND=local
